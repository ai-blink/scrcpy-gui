<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>../../src/ScrcpyGui/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/ScrcpyGui/Remote*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../src/ScrcpyGui/MainWindow*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../src/ScrcpyGui/OptionDefinition.cs" Link="OptionDefinition.cs" />
    <Compile Include="../../src/ScrcpyGui/ScrcpyCommandLine.cs" Link="ScrcpyCommandLine.cs" />
    <Page Include="../../src/ScrcpyGui/MainWindow.xaml" Link="MainWindow.xaml" />
    <Resource Include="../../src/ScrcpyGui/app-icon.ico" Link="app-icon.ico" />
  </ItemGroup>
  <Target Name="CopyMainWindowSource" AfterTargets="Build">
    <Copy SourceFiles="../../src/ScrcpyGui/MainWindow.xaml" DestinationFiles="$(TargetDir)MainWindow.source.xaml" />
  </Target>
</Project>
